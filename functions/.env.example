# Non-secret Cloud Functions params. Copy to functions/.env before deploy.
# OPENAI_API_KEY and FINGERPRINT_PEPPER are secrets, not env values:
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set FINGERPRINT_PEPPER
OPENAI_MODEL=gpt-4o-mini
AI_FREE_REFRESHES_PER_PERSON=5
AI_PAID_REFRESHES_PER_PERSON_PER_MONTH=20
FREE_TIER_MAX_PEOPLE=5
GROUP_MAX_MEMBERS=5
IAP_UNLOCK_PRODUCT_ID=gifteez_unlock
APPLE_BUNDLE_ID=com.gifteez
GOOGLE_PLAY_PACKAGE_NAME=com.gifteez
# Optional. Leave blank until store credentials exist. Purchases stay locked until these verify.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT=
