rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in groupData(groupId).memberIds;
    }

    function sameMembers(before, after) {
      return before.hasAll(after) && after.hasAll(before);
    }

    function selfLeave(before, after) {
      return before.hasAll(after)
        && before.size() == after.size() + 1
        && before.hasAny([request.auth.uid])
        && !after.hasAny([request.auth.uid]);
    }

    function ownerRemoves(before, after) {
      return request.auth.uid == resource.data.ownerId
        && before.hasAll(after)
        && before.size() == after.size() + 1;
    }

    function personDoc(groupId, personId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/people/$(personId)).data;
    }

    function personLinked(groupId, personId) {
      return personDoc(groupId, personId).get('linkedUid', '');
    }

    function personLocked(groupId, personId) {
      return groupData(groupId).get('lockedPersonIds', []).hasAny([personId]);
    }

    function unchangedAdmin(groupId) {
      return request.resource.data.entitled == resource.data.entitled
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.peopleCount == resource.data.peopleCount
        && request.resource.data.get('keyVersion', 0) == resource.data.get('keyVersion', 0)
        && request.resource.data.get('needsRotation', false) == resource.data.get('needsRotation', false)
        && request.resource.data.get('lockedPersonIds', []) == resource.data.get('lockedPersonIds', [])
        && request.resource.data.get('rotatingBy', '') == resource.data.get('rotatingBy', '');
    }

    match /groups/{groupId} {
      allow get: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow list: if false;

      // Direct creates are denied. createOwnedGroup enforces one owned list for a free account.
      allow create: if false;

      // entitled, ownerId, peopleCount, keyVersion, needsRotation, and lockedPersonIds are server-owned.
      // peopleCount is the real count from writePerson, not a client counter.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && unchangedAdmin(groupId)
        && request.resource.data.memberIds.size() >= 1
        // GROUP_MAX_MEMBERS. Recipient caps are enforced by writePerson, not this update.
        && request.resource.data.memberIds.size() <= 10
        && (
          sameMembers(resource.data.memberIds, request.resource.data.memberIds)
          || selfLeave(resource.data.memberIds, request.resource.data.memberIds)
          || ownerRemoves(resource.data.memberIds, request.resource.data.memberIds)
        );

      // Owner deletes go through releaseOwnedGroup so the free slot is freed and subcollections go with it.
      allow delete: if false;

      // claimedBy, claimedAt, and boughtBy live inside ciphertext. Rules cannot read them.
      // A linked recipient cannot read that person's gifts: those docs live under hidden/{linkedUid}.
      // The group key still seals them. Rules are the barrier, because every member holds that key.
      // Private gifts are not group docs; see users/{uid}/privateGifts.
      match /people/{personId} {
        allow read: if isMember(groupId);
        allow write: if false;
      }

      match /keyWraps/{version} {
        allow read: if isMember(groupId);
        allow create, update: if isMember(groupId)
          && request.resource.data.updatedAt is number
          && request.resource.data.ciphertext is string;
        allow delete: if false;
      }

      match /hidden/{excludedUid}/{collection}/{docId} {
        allow read: if isMember(groupId) && request.auth.uid != excludedUid;
        allow create, update: if isMember(groupId)
          && request.auth.uid != excludedUid
          && collection in ['states', 'gifts', 'ideas']
          && request.resource.data.updatedAt is number
          && request.resource.data.ciphertext is string
          && request.resource.data.personId is string
          && personLinked(groupId, request.resource.data.personId) == excludedUid
          && !personLocked(groupId, request.resource.data.personId);
        allow delete: if isMember(groupId) && request.auth.uid != excludedUid;
      }

      match /{collection}/{docId} {
        allow read: if isMember(groupId)
          && collection != 'hidden'
          && collection != 'keyWraps'
          && collection != 'people';
        allow create, update: if isMember(groupId)
          && collection != 'people'
          && collection != 'hidden'
          && collection != 'keyWraps'
          && request.resource.data.updatedAt is number
          && request.resource.data.ciphertext is string
          && (
            collection == 'members'
            || (
              collection == 'occasions'
              && request.resource.data.personId is string
              && !personLocked(groupId, request.resource.data.personId)
            )
            || (
              (collection == 'states' || collection == 'gifts' || collection == 'ideas')
              && request.resource.data.personId is string
              && personLinked(groupId, request.resource.data.personId) == ''
              && !personLocked(groupId, request.resource.data.personId)
            )
          );
        allow delete: if isMember(groupId)
          && collection != 'people'
          && collection != 'hidden'
          && collection != 'keyWraps'
          && (
            collection == 'members'
            || !(resource.data.personId is string)
            || !personLocked(groupId, resource.data.personId)
          );
      }
    }

    match /invites/{inviteId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy
        && request.resource.data.active == true
        && request.resource.data.ciphertext is string
        && request.auth.uid in groupData(request.resource.data.groupId).memberIds;
      allow update: if signedIn()
        && request.auth.uid == resource.data.createdBy
        && request.auth.uid in groupData(resource.data.groupId).memberIds
        && request.resource.data.ciphertext is string
        && request.resource.data.groupId == resource.data.groupId
        && (resource.data.active == true || request.resource.data.active == false);
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /keys/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Unchecked merge gifts. Ciphertext is sealed with the device key, not the group key.
      match /privateGifts/{giftId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.updatedAt is number
          && request.resource.data.ciphertext is string;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /aiUsage/{fingerprint} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /aiCache/{fingerprint}/{document=**} {
      allow read, write: if false;
    }

    match /accounts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /entitlements/{fingerprint} {
      allow read, write: if false;
    }
  }
}
