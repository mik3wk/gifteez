rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // People, occasions, gifts, and ideas stay on the phone. These collections
    // are only the AI cap and the purchase record. Clients cannot write them.
    match /aiUsage/{fingerprint} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /aiCache/{fingerprint}/{document=**} {
      allow read, write: if false;
    }

    match /accounts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /entitlements/{fingerprint} {
      allow read, write: if false;
    }
  }
}
