# Gifteez environment variables (EXAMPLE ONLY - placeholders, no real secrets)
# Copy to .env for local development. Never commit .env.

# ---------- Firebase app config (client; identifies the project, not secret but keep out of git) ----------
# Firebase Web/API key used by the app to talk to Firebase services
FIREBASE_API_KEY=your-firebase-api-key
# Firebase Auth domain (used for email magic links / auth redirects)
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Firebase project ID
FIREBASE_PROJECT_ID=your-project-id
# Cloud Storage bucket (downloadable seasonal skins live here)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# Firebase Cloud Messaging sender ID
FIREBASE_MESSAGING_SENDER_ID=000000000000
# Firebase app ID for iOS
FIREBASE_IOS_APP_ID=1:000000000000:ios:0000000000000000
# Firebase app ID for Android
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000
# Google Analytics for Firebase measurement ID (optional analytics)
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Cloud Functions region for the AI proxy
FIREBASE_FUNCTIONS_REGION=us-central1

# ---------- Phone auth / text messages ----------
# Phone sign-in SMS is sent by Firebase Auth itself (billed per SMS on Blaze); no separate SMS provider key needed.
# Country codes allowed to receive sign-in texts (limits SMS cost to launch regions)
PHONE_AUTH_ALLOWED_REGIONS=US
# App Check debug token for simulators/emulators during development only
APP_CHECK_DEBUG_TOKEN=your-app-check-debug-token

# ---------- Deep links / group invites ----------
# Domain used for shareable group invite links
INVITE_LINK_DOMAIN=gifteez.app

# ---------- Remote Config ----------
# Remote Config key that flips seasonal/event skins on by date (name of the parameter, not a secret)
REMOTE_CONFIG_SKIN_PARAM=active_skin
# Minimum Remote Config fetch interval in seconds
REMOTE_CONFIG_MIN_FETCH_SECONDS=3600

# ---------- In-app purchase ----------
# Product ID for the $9.99 one-time unlock
IAP_UNLOCK_PRODUCT_ID=gifteez_unlock

# ---------- Cloud AI (SERVER ONLY - Cloud Functions, never shipped in the app) ----------
# OpenAI API key; store with `firebase functions:secrets:set OPENAI_API_KEY`, never in the app bundle
OPENAI_API_KEY=sk-your-openai-key-server-only
# OpenAI model used by the proxy for gift ideas
OPENAI_MODEL=your-model-name
# Free-tier fresh cloud generations allowed per person (cap enforced server-side)
AI_FREE_REFRESHES_PER_PERSON=5
# Paid-tier fresh generations per person per month; starting cap, may change based on observed abuse and per-refresh API cost
AI_PAID_REFRESHES_PER_PERSON_PER_MONTH=20
# Free-tier people limit
FREE_TIER_MAX_PEOPLE=5
