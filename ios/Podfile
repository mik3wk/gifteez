# The React Native CLI sets RCT_NEW_ARCH_ENABLED=0 when ios/Pods/Pods.xcodeproj
# is missing (a fresh checkout: getArchitecture fails closed, and installPods
# passes that as the env). RNFBApp.podspec raises when the value is '0'.
# react-native-config enables Fabric only when the value is already '1' at
# podspec load. use_native_modules! loads those podspecs before use_react_native!
# sets the flag, so set it before this file requires anything else.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Register the Firebase package `traits` attribute before anything opens the
# Xcode project. Otherwise xcodeproj drops the key on the next save and the
# Firestore trait goes back off. See ios/firebase_spm_traits.rb.
require_relative 'firebase_spm_traits'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase 27 installs the Firebase Apple SDK with Swift Package
# Manager. SPM builds require dynamic frameworks; static linkage fails pod install.
# The same linkage lets the Gifteez target import FirebaseCore. pod install adds
# that SPM product to the app target (see post_integrate below).
#
# Firebase 13's Firestore product does not compile unless the package's Firestore
# trait is on. Xcode 26.2 ignores a `traits` key on the package reference (Xcode
# 26.4+ is what reads it). ios/FirebaseFirestoreTrait is a local package that
# depends on firebase-ios-sdk with the Firestore trait enabled, which SwiftPM
# 6.2 does honor. pod install links that package from the RNFBFirestore pod.
# Auth, App Check, Functions, Remote Config, and Storage are not trait-gated.
use_frameworks! :linkage => :dynamic

target 'Gifteez' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Pods.xcodeproj is saved after this hook. The Firestore product dependency
    # lives on the RNFBFirestore pod, so the trait has to be on this project.
    gifteez_enable_firebase_spm_traits_for_installer(installer)
    gifteez_install_firebase_spm_traits_hook!(installer)
  end

  post_integrate do |installer|
    if defined?(rnfirebase_add_spm_core_to_app_target)
      rnfirebase_add_spm_core_to_app_target(installer)
    end
    # The app target's firebase-ios-sdk reference is created just above. RNFB's
    # own post_integrate wrapper runs after this block and is covered by the
    # hook installed in post_install.
    gifteez_enable_firebase_spm_traits_for_installer(installer)
  end
end
