# The React Native CLI sets RCT_NEW_ARCH_ENABLED=0 when ios/Pods/Pods.xcodeproj
# is missing (a fresh checkout: getArchitecture fails closed, and installPods
# passes that as the env). RNFBApp.podspec raises when the value is '0'.
# react-native-config enables Fabric only when the value is already '1' at
# podspec load. use_native_modules! loads those podspecs before use_react_native!
# sets the flag, so set it before this file requires anything else.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase 27 installs the Firebase Apple SDK with Swift Package
# Manager. SPM builds require dynamic frameworks; static linkage fails pod install.
# The same linkage lets the Gifteez target import FirebaseCore. pod install adds
# that SPM product to the app target (see post_integrate below).
use_frameworks! :linkage => :dynamic

target 'Gifteez' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end

  post_integrate do |installer|
    if defined?(rnfirebase_add_spm_core_to_app_target)
      rnfirebase_add_spm_core_to_app_target(installer)
    end
  end
end
